{
  "name": "eventsapiens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "bun node_modules/vite/bin/vite.js --port=5173 --host=127.0.0.1 --strictPort",
    "build": "bun node_modules/vite/bin/vite.js build",
    "preview": "bun node_modules/vite/bin/vite.js preview",
    "clean": "bun -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "lint": "bun run typecheck",
    "validate": "bun scripts/validate-events.ts",
    "archive": "bun scripts/archive-events.ts",
    "archive:dry-run": "bun scripts/archive-events.ts --dry-run",
    "test": "bun test",
    "check": "bun run validate && bun test && bun run lint && bun run build"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
